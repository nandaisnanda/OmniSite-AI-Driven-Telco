# Copy this file to `.streamlit/secrets.toml`. Never commit real credentials.
#
# Every key below is read by app.py. Anything the app does not implement is not listed
# here — an earlier version of this file advertised OIDC_* keys and a concurrency limit
# that no code path ever read, which made deployments look protected when they were not.
# All values may also be supplied as environment variables, which take precedence.

# --- Data sources ---------------------------------------------------------------
# Without OPENCELLID_API_KEY the RF engine reports "not configured" and the coverage-gap
# finder refuses to run rather than treat an unknown tower inventory as empty ground.
OPENCELLID_API_KEY = "your-key-here"
# Earth Engine service-account JSON. Without it the geospatial engine falls back to
# public elevation only, and most sites will be reported as unscreenable rather than scored.
GEE_SERVICE_ACCOUNT_FILE = "apigee.json"

# --- Authentication -------------------------------------------------------------
# Leave AUTH_ENABLED false only for local development. With it false the app is open to
# anyone who can reach the URL, and every visitor spends your OpenCelliD and Earth
# Engine quota.
AUTH_ENABLED = "false"

# "session" = shared access password, enforced by app.py (see require_authentication).
# "oidc"    = delegate to Streamlit's built-in OIDC login. Configure the provider in the
#             [auth] section below, per Streamlit's own documentation — the app does not
#             implement its own OIDC client and will refuse to start if the installed
#             Streamlit has no st.login.
AUTH_MODE = "session"

# Required when AUTH_ENABLED = "true" and AUTH_MODE = "session".
# With auth enabled and this unset, the app fails closed rather than serving unprotected.
# APP_PASSWORD = "choose-a-long-random-passphrase"

# Required when AUTH_MODE = "oidc" — consumed by Streamlit, not by app.py.
# [auth]
# redirect_uri = "https://your-app.example.com/oauth2callback"
# cookie_secret = "a-long-random-string"
# [auth.auth0]
# client_id = "your-client-id"
# client_secret = "your-client-secret"
# server_metadata_url = "https://your-idp.example.com/.well-known/openid-configuration"

# --- Quota protection -----------------------------------------------------------
# Per-session ceilings, enforced before work is submitted. Each analysis spends
# OpenCelliD, Earth Engine and Overpass quota that is not refundable.
RATE_LIMIT_ANALYSIS_PER_MINUTE = "10"
RATE_LIMIT_RECOMMEND_PER_MINUTE = "3"
# Ceiling on background analyses queued at once per session.
MAX_QUEUED_JOBS = "50"
# A point still unfinished after this many seconds is abandoned and reported as timed
# out. Keep well above 45 s: a cold ten-year wind-archive request alone takes that long.
JOB_TIMEOUT_SECONDS = "150"

# --- Diagnostics ----------------------------------------------------------------
# Environment variable only (not a secret): DEBUG, INFO, WARNING, ERROR.
# OMNISITE_LOG_LEVEL = "INFO"
